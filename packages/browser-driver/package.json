{
  "name": "@holaday/browser-driver",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./mock": {
      "types": "./src/mock.ts",
      "default": "./src/mock.ts"
    },
    "./crx": {
      "types": "./src/crx-adapter.ts",
      "default": "./src/crx-adapter.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf .turbo"
  },
  "dependencies": {
    "@holaday/shared-types": "workspace:*"
  },
  "devDependencies": {
    "@types/chrome": "0.0.287",
    "@types/node": "22.10.2",
    "playwright-crx": "0.15.0",
    "rimraf": "6.0.1",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  }
}
