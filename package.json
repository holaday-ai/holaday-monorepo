    "format": "biome format --write .",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "rimraf": "6.0.1",
    "turbo": "2.5.8",
    "typescript": "5.7.3"
  }
}
