{
  "name": "holaday-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "HOLA DAY — Browser Agent monorepo (Phase 0)",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
