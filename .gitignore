# Claude Code per-session artifacts (locks / log buffers / settings.local).
# Skill / agent / command definitions stay tracked elsewhere; only ephemeral
# files in the worktree's `.claude/` show up here.
.claude/scheduled_tasks.lock
.claude/settings.local.json

# Dependencies
node_modules/
.pnpm-store/

# Build artifacts
dist/
build/
.next/
out/
*.tsbuildinfo

# Turbo
.turbo/
.worktrees/

# Local Superpowers/subagent execution ledgers.
.superpowers/

# Coverage
coverage/
.nyc_output/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*

# Env
.env
.env.local
