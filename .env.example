# Copy to .env and fill in locally. Never commit .env.

# MySQL
MYSQL_ROOT_PASSWORD=holaday-dev-root
MYSQL_DATABASE=holaday
MYSQL_USER=holaday
MYSQL_PASSWORD=holaday-dev
MYSQL_PORT=3306

# Redis
REDIS_PORT=6379

# MinIO (S3-compatible)
MINIO_ROOT_USER=holaday
MINIO_ROOT_PASSWORD=holaday-dev
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Orchestrator
NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=mysql://holaday:holaday-dev@127.0.0.1:3306/holaday
REDIS_URL=redis://127.0.0.1:6379/0
JWT_SECRET=change-me-to-a-long-random-string-please
# 32 random bytes encoded as base64; generate with: openssl rand -base64 32
MFA_MASTER_KEY=
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=holaday
S3_SECRET_KEY=holaday-dev
S3_BUCKET=holaday-artifacts

# Partner ledger
PARTNER_LEDGER_ENABLED=false
# Amounts are HOLA Credit cents. Defaults mirror the backend fallbacks.
PARTNER_WITHDRAWAL_MIN_CREDIT_CENTS=50000
PARTNER_WITHDRAWAL_DAILY_PLATFORM_CAP_CREDIT_CENTS=20000000
PARTNER_WITHDRAWAL_MONTHLY_USER_CAP_CREDIT_CENTS=10000000
PARTNER_WITHDRAWAL_BANK_CARD_COOLDOWN_DAYS=7

# Anthropic
ANTHROPIC_API_KEY=

# Google Gemini (image generation and independent final-video review)
GEMINI_API_KEY=
GEMINI_VIDEO_REVIEW_MODEL=gemini-3.6-flash

# Cosmic / Astrology provider
# ASTROLOGY_ENABLED=true enables the backend astrology tRPC router to use
# provider-backed responses when credentials are configured.
ASTROLOGY_ENABLED=false
# DivineAPI credentials stay server-side. Leave blank to use deterministic mock
# fallback for Cosmic daily horoscope / tarot.
DIVINE_API_KEY=
DIVINE_ACCESS_TOKEN=
# Optional overrides. English and translated traffic use separate hosts.
# The default English base URL is https://astroapi-5.divineapi.com.
DIVINE_API_BASE_URL=
DIVINE_API_TRANSLATOR_BASE_URL=https://astroapi-5-translator.divineapi.com
# Comma-separated allowlist produced by a controlled capability probe.
# Production-verified horoscope baseline: daily, weekly, monthly, yearly.
DIVINE_API_CAPABILITIES=
DIVINE_API_CAPABILITIES_CHECKED_AT=
# Business denials temporarily disable only the affected endpoint. Default: 15 minutes.
DIVINE_API_CAPABILITY_REFRESH_TTL_MS=900000
# Default: 21600000 (6 hours). Set to 0 to disable in-memory provider caching.
DIVINE_API_CACHE_TTL_MS=21600000
# A previously validated response may be reused after a transient failure. Default: 24 hours.
DIVINE_API_STALE_IF_ERROR_MS=86400000

# Supercar lane adapters — leave blank to disable a lane
BRAVE_API_KEY=
ZAPIER_API_KEY=
APIFY_API_TOKEN=

# Managed browser pool. Run the orchestrator as a non-root OS user so
# Chromium's process sandbox remains enabled. Full-desktop VNC is disabled by
# default; the product browser uses the narrower CDP screencast transport.
MULTI_USER=false
MAX_BROWSER_INSTANCES=10
BROWSER_VNC_WS_ENABLED=false

# Phase 9 — login & payment (Stage 1: international users)
# Google OAuth: BOSS provides client id/secret tomorrow.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Resend: BOSS provides api key tomorrow. Without it the email-code
# service logs codes to stdout (dev mode) and never delivers email.
RESEND_API_KEY=
RESEND_FROM_EMAIL=HOLA DAY <noreply@holaday.ai>
# PayPal: register a sandbox app at developer.paypal.com → My Apps.
# PayPal is opt-in. Keep disabled until the live account and webhook pass preflight.
# PAYPAL_ENV=sandbox keeps it in test mode; flip to "live" to charge.
# PAYPAL_WEBHOOK_ID may be blank only in local development. Production
# rejects unsigned webhook events when this value is missing.
PAYPAL_ENABLED=false
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=
