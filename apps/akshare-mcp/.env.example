# akshare-mcp config — copy to .env (gitignored) and adjust.
# Per-interface cache TTL (seconds). Real-time data short, slow data long.
AKSHARE_MCP_TTL_QUOTE=15
AKSHARE_MCP_TTL_KLINE=300
AKSHARE_MCP_TTL_ANNOUNCE=1800
AKSHARE_MCP_TTL_LHB=3600
AKSHARE_MCP_TTL_NORTHBOUND=60
AKSHARE_MCP_TTL_INDEX=60

# Max rows returned per tool call (keeps model context bounded).
AKSHARE_MCP_MAX_ROWS=50
