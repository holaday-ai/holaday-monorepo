# --- General ---
NODE_ENV=production
PORT=4010
LOG_LEVEL=info

# Public origin for callback URLs the SDKs hand to WeChat / Alipay.
# Both providers POST back here from China-side networks; MUST resolve
# from mainland China (orangebench.tech is ICP-filed, holaday.ai is not).
PUBLIC_ORIGIN=https://hd-pay.orangebench.tech

# --- Vultr bridge ---
# Where to call back to update users.plan + payments table after a
# successful gateway notification. The HMAC-style shared secret is
# checked on the Vultr side; mismatched value → 401 + payment stuck
# pending. Generate once with `openssl rand -hex 32` and put the same
# value in BOTH .env files.
VULTR_INTERNAL_URL=https://holaday.ai/api/internal/payment/confirm
INTERNAL_SHARED_SECRET=<paste 64-char hex from openssl rand -hex 32>

# --- WeChat Pay v3 ---
# All credentials come from https://pay.weixin.qq.com — Apps & Mch.
# v3 (not legacy v2). Pay attention to "商户号" vs "AppID" — the SDK
# distinguishes them and a transposition silently 401s every order.
WX_APPID=
WX_MCHID=
# v3 API key. NOT the v2 "API 密钥". 32 chars, set in mch portal.
WX_API_V3_KEY=
# Cert files. Point at absolute paths on the deploy host. Both files
# come from the WX mch portal under "API 安全".
WX_CERT_PATH=/opt/holaday-cn-payment/certs/apiclient_cert.pem
WX_KEY_PATH=/opt/holaday-cn-payment/certs/apiclient_key.pem
# WeChat platform cert (downloaded via the portal or fetched on first
# `pay.get_certificates()` call). Used to verify callback signatures.
WX_PLATFORM_CERT_PATH=/opt/holaday-cn-payment/certs/wx_platform_cert.pem

# --- Alipay ---
# All from https://open.alipay.com under "应用".
ALIPAY_APPID=
# Application's RSA-2048 private key, PEM (no header/footer when
# pasted as a single env line; preserve the BEGIN/END markers when
# the file is consumed verbatim — alipay-sdk auto-strips).
ALIPAY_PRIVATE_KEY=
# Alipay public key (for verifying callback signatures). Matches the
# private key Alipay uses to sign notifications back to us.
ALIPAY_PUBLIC_KEY=
# Either 'sandbox' or 'production'. Sandbox uses openapi.alipaydev.com
# rather than openapi.alipay.com. BOSS will flip after the live keys
# are in.
ALIPAY_MODE=production
