{
  "name": "@holaday/orchestrator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    "./trpc/router": {
      "types": "./src/trpc/router.ts",
      "default": "./src/trpc/router.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/qa-db-safety.test.mjs scripts/qa-report-metadata.test.mjs scripts/release-db-contract.test.mjs && vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "qa:web": "node scripts/web-ui-qa.mjs",
    "qa:browser-release": "pnpm qa:web && pnpm smoke:browser-egress",
    "sync-skills": "tsx scripts/sync-skills.ts",
    "smoke-anthropic": "tsx scripts/smoke-anthropic.ts",
    "smoke:browser-egress": "tsx scripts/smoke-browser-egress.ts",
    "eval": "tsx src/eval/eval-runner.ts",
    "eval:smoke": "tsx src/eval/eval-runner.ts p0-smoke",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:numbered": "tsx scripts/apply-numbered-migrations.ts",
    "db:push": "drizzle-kit push",
    "db:verify": "tsx scripts/verify-db-schema.ts",
    "partner:daily": "tsx scripts/partner-run-daily.ts",
    "partner:monthly": "tsx scripts/partner-run-monthly.ts",
    "db:studio": "drizzle-kit studio",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.90.0",
    "@aws-sdk/client-s3": "^3.689.0",
    "@aws-sdk/s3-request-presigner": "^3.689.0",
    "@holaday/shared-types": "workspace:*",
    "@holaday/skill-sdk": "workspace:*",
    "@trpc/server": "11.0.0",
    "argon2": "0.41.1",
    "docx": "^9.6.1",
    "docxtemplater": "^3.68.7",
    "dotenv": "16.4.7",
    "drizzle-orm": "0.38.4",
    "exceljs": "^4.4.0",
    "express": "5.1.0",
    "global-agent": "^4.1.3",
    "https-proxy-agent": "^9.0.0",
    "ioredis": "5.4.2",
    "jose": "5.9.6",
    "js-yaml": "^4.1.1",
    "multer": "^2.1.1",
    "mysql2": "3.11.5",
    "nanoid": "5.0.9",
    "openai": "^4.78.1",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.18.0",
    "pino": "9.5.0",
    "pino-http": "10.3.0",
    "pizzip": "^3.2.0",
    "playwright": "^1.59.1",
    "pptxgenjs": "^4.0.1",
    "rrule": "^2.8.1",
    "sharp": "^0.34.5",
    "undici": "^8.1.0",
    "ws": "8.18.0",
    "xlsx": "^0.18.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "5.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/multer": "^2.1.0",
    "@types/node": "22.10.2",
    "@types/pdfkit": "^0.17.6",
    "@types/ws": "8.5.13",
    "@vitest/coverage-v8": "2.1.8",
    "drizzle-kit": "0.31.10",
    "rimraf": "6.0.1",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  }
}
