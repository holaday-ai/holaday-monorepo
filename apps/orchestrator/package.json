{
  "name": "@holaday/orchestrator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.39.0",
    "@holaday/shared-types": "workspace:*",
    "@trpc/server": "11.0.0",
    "argon2": "0.41.1",
    "dotenv": "16.4.7",
    "drizzle-orm": "0.38.4",
    "express": "5.1.0",
    "ioredis": "5.4.2",
    "jose": "5.9.6",
    "mysql2": "3.11.5",
    "nanoid": "5.0.9",
    "pino": "9.5.0",
    "pino-http": "10.3.0",
    "ws": "8.18.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/express": "5.0.0",
    "@types/node": "22.10.2",
    "@types/ws": "8.5.13",
    "drizzle-kit": "0.31.10",
    "rimraf": "6.0.1",
    "tsx": "4.19.2",
    "typescript": "5.7.3"
  }
}
