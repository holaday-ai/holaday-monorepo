{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "noEmit": false,
    // Orchestrator is an app, not a library — nothing imports it as
    // a typed package. Skipping declaration emit also bypasses the
    // TS2742 cascade triggered by pnpm-hoisted Express types in
    // tRPC/Drizzle generic inference. See the audit note (F16).
    "declaration": false,
    "declarationMap": false,
    "sourceMap": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/__tests__/**"]
}
