{
  "name": "@holaday/extension",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "VITE_EXTENSION_INCLUDE_DEV_HOSTS=1 vite build --watch --mode development",
    "build": "vite build",
    "build:debug": "VITE_EXTENSION_SOURCEMAP=1 vite build",
    "package:chrome": "../../scripts/package-extension.sh",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@holaday/browser-driver": "workspace:*",
    "@holaday/shared-types": "workspace:*",
    "playwright-crx": "0.15.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "5.0.2"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "2.0.0-beta.31",
    "@types/chrome": "0.0.287",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "rimraf": "6.0.1",
    "typescript": "5.7.3",
    "vite": "6.0.7",
    "vitest": "2.1.8"
  }
}
