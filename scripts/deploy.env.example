# Copy to .env.deploy.local or ~/.config/holaday/deploy.env.
# Never commit real values.

ALIYUN_PASSWORD='replace-me'
VULTR_PASSWORD='replace-me'

# A fast, non-browser P0 release gate runs by default and rolls back on failure.
# Emergency bypass only; do not keep this enabled in the normal deploy env:
# SKIP_RELEASE_GATE=1

# Optional: run the slower 11-case browser/search suite after the blocking gate.
RUN_FULL_AUTO_SMOKE=0
